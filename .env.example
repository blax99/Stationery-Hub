# .env.example
# Copy this file to .env and fill in your own values

# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Django
SECRET_KEY=django-insecure-dummy-secret-key-for-development-only-replace-in-production
DEBUG=True
SITE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# Registration and password-reset email (Resend API over HTTPS)
EMAIL_TIMEOUT=10
RESEND_API_KEY=re_your_resend_api_key
DEFAULT_FROM_EMAIL=Stationery Hub <passwords@your-verified-domain.example>

# Khalti payment gateway
KHALTI_SECRET_KEY=live_secret_key_from_test_merchant_portal
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_WEBSITE_URL=http://127.0.0.1:8000/
KHALTI_RETURN_URL=http://127.0.0.1:8000/api/payments/verify/

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret